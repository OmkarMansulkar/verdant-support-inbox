# Copy to backend/.env for local development. Never commit the real .env.

# Supabase > Connect > "Session pooler" connection string (not the direct one: it is IPv6-only)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# HMAC secret used to sign webhook requests (value given in the assessment brief)
WEBHOOK_SECRET=verdant-demo-secret-2026

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# https://console.groq.com/keys
GROQ_API_KEY=<groq-api-key>

# Local development uses the small model to save the 70B model's daily token budget for production
LLM_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
